import streamlist as st
import ollama
st.title("Welcome to AI Chatbot")
st.caption("hii")
prompt=st.text_input("Ask me an")
if st.button("Generate"):
    response=ollama.chat(
        model="llama3.2",
        messages=[
            {
                "role": "user",
                "content":prompt
            }
        ]
    )
    st.write(response["message"]["content"])